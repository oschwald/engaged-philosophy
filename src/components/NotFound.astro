---
import Base from "../layouts/Base.astro";
import SearchIcon from "./SearchIcon.astro";
---

<Base title="Not Found" bodyClass="error404 not-found">
	<section id="primary" class="col-12 px-4">
		<div id="content" role="main">
			<article class="post error404 not-found">
				<header class="page-header">
					<h1 class="entry-title">Page not found</h1>
				</header>
				<div class="entry-content">
					<p>
						This page does not exist or has moved. Search the site, or use the
						menu above.
					</p>

					<form method="get" id="searchform" class="d-flex" action="/">
						<label for="not-found-search" class="visually-hidden">
							Search
						</label>
						<input
							id="not-found-search"
							class="form-control"
							type="search"
							name="s"
							placeholder="Search"
						/>
						<button
							class="btn btn-outline-secondary ms-1"
							name="submit"
							id="searchsubmit"
							type="submit"
							aria-label="Submit search"
						>
							<SearchIcon />
						</button>
					</form>
				</div>
			</article>
		</div>
	</section>
</Base>
