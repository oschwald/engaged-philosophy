---
import type { MenuItem } from "emdash";
import SearchIcon from "../SearchIcon.astro";

interface Props {
	menuItems: MenuItem[];
	// Undefined when the page is not a menu destination, such as search results
	currentPath?: string;
	// Menu URL of the section the page belongs to, such as /project/
	sectionPath?: string;
}

const { menuItems, currentPath, sectionPath } = Astro.props;

function isCurrentUrl(url: string) {
	if (currentPath === undefined) {
		return false;
	}
	return url === currentPath || url === `${currentPath}/`;
}
---

<nav id="access" aria-label="Main navigation">
	<h3 class="visually-hidden">Main menu</h3>
	<div class="navbar navbar-expand-lg">
		<button
			class="navbar-toggler"
			type="button"
			data-bs-toggle="collapse"
			data-bs-target="#navbarNav"
			aria-controls="navbarNav"
			aria-expanded="false"
			aria-label="Toggle navigation"
		>
			<span class="navbar-toggler-icon"></span>
		</button>

		<div class="collapse navbar-collapse" id="navbarNav">
			<div class="menu-main-menu-container">
				<ul id="menu-main-menu" class="navbar-nav ms-auto">
					{menuItems.map((item) => {
						const hasChildren = item.children.length > 0;
						const isActive = isCurrentUrl(item.url);
						const isSection = !isActive && item.url === sectionPath;
						let ariaCurrent: "page" | "true" | undefined;
						if (isActive) {
							ariaCurrent = "page";
						} else if (isSection) {
							ariaCurrent = "true";
						}
						const isBranchActive =
							hasChildren &&
							item.children.some((child) => isCurrentUrl(child.url));

						return (
							<li
								class:list={[
									"menu-item",
									"nav-item",
									hasChildren && "dropdown",
									(isActive || isSection || isBranchActive) && "active",
								]}
							>
								<a
									class:list={["nav-link", hasChildren && "dropdown-toggle"]}
									href={hasChildren ? "#" : item.url}
									target={item.target}
									aria-current={ariaCurrent}
									{...(hasChildren
										? {
												"data-bs-toggle": "dropdown",
												"aria-expanded": "false",
												"aria-haspopup": "true",
											}
										: {})}
								>
									{item.label}
								</a>
								{hasChildren && (
									<ul class="dropdown-menu">
										{item.children.map((child) => (
											<li class="menu-item nav-item">
												<a
													class="dropdown-item"
													href={child.url}
													target={child.target}
													aria-current={
														isCurrentUrl(child.url) ? "page" : undefined
													}
												>
													{child.label}
												</a>
											</li>
										))}
									</ul>
								)}
							</li>
						);
					})}
				</ul>
			</div>
			<form
				id="searchform"
				class="d-flex ms-auto"
				method="get"
				action="/"
				role="search"
				aria-label="Search the site"
			>
				<label for="s" class="visually-hidden">
					Search
				</label>
				<input
					type="search"
					class="form-control"
					name="s"
					id="s"
					placeholder="Search"
					aria-label="Search the site"
				/>
				<button
					type="submit"
					class="btn btn-outline-secondary ms-1"
					aria-label="Submit search"
				>
					<SearchIcon />
				</button>
			</form>
		</div>
	</div>
</nav>
