---
import { Gallery as EmDashGallery } from "emdash/ui";

import type { RichTextGalleryNode } from "../../lib/rich-text-types";

interface Props {
	node: RichTextGalleryNode;
}

const { node } = Astro.props;
const usesLeadLayout =
	node.layout === "shortcode" && node.columns === 3 && node.images.length === 4;
const firstImage = node.images[0];
const hasSeparateCaption = Boolean(
	node.caption && firstImage && firstImage.caption,
);
const galleryNode =
	node.caption && firstImage && !firstImage.caption
		? {
				...node,
				images: [
					{ ...firstImage, caption: node.caption },
					...node.images.slice(1),
				],
			}
		: node;
---

<div
	class:list={[
		"legacy-gallery-compat",
		node.layout && `legacy-gallery-compat--${node.layout}`,
		node.columns && `legacy-gallery-compat--columns-${node.columns}`,
		usesLeadLayout && "legacy-gallery-compat--lead",
		hasSeparateCaption && "legacy-gallery-compat--separate-caption",
	]}
>
	<EmDashGallery node={galleryNode} />
	{
		hasSeparateCaption && (
			<p class="legacy-gallery-compat__caption">{node.caption}</p>
		)
	}
</div>
