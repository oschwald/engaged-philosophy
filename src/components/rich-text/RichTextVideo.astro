---
import type { ComponentProps } from "astro/types";
import { Video } from "emdash/ui";

import { safeUrlForMediaSrc } from "../../lib/url-safety";

type Props = ComponentProps<typeof Video>;

const { node } = Astro.props;
const src = safeUrlForMediaSrc(node.asset?.url);
const validSource =
	!node.asset?.url ||
	src.startsWith("https://") ||
	src.startsWith("/_emdash/api/media/file/");
---

{node.asset && validSource && (
	<div class="content-video" role="group" aria-label={node.caption || "Video"}>
		<Video
			node={{ ...node, asset: { ...node.asset, url: src || undefined } }}
		/>
	</div>
)}
