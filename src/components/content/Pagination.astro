---
interface Props {
	currentPage: number;
	hasMore?: boolean;
	pageHref: (pageNumber: number) => string;
	nextLinkClass?: string;
}

const {
	currentPage,
	hasMore = false,
	pageHref,
	nextLinkClass = "",
} = Astro.props;

const showPagination = currentPage > 1 || hasMore;
---

{showPagination && (
	<nav aria-label="Page navigation">
		<ul class="pagination justify-content-center">
			<li class:list={["page-item", currentPage === 1 && "disabled"]}>
				{currentPage === 1 ? (
					<span class="page-link">&laquo; Previous</span>
				) : (
					<a class="page-link" href={pageHref(currentPage - 1)}>
						&laquo; Previous
					</a>
				)}
			</li>
			<li class:list={["page-item", !hasMore && "disabled"]}>
				{!hasMore ? (
					<span class="page-link">Next &raquo;</span>
				) : (
					<a
						class:list={["page-link", nextLinkClass]}
						href={pageHref(currentPage + 1)}
					>
						Next &raquo;
					</a>
				)}
			</li>
		</ul>
	</nav>
)}
