---
interface SummaryImage {
	src?: string;
	alt?: string;
}

interface Props {
	articleClass: string;
	title: string;
	meta?: string;
	excerpt?: string;
	continueHref: string;
	image?: SummaryImage | null;
	imageClass?: string;
	showContinueWithoutExcerpt?: boolean;
}

const {
	articleClass,
	title,
	meta = "",
	excerpt = "",
	continueHref,
	image,
	imageClass = "img-thumbnail float-end ms-3",
	showContinueWithoutExcerpt = true,
} = Astro.props;
const shouldShowSummary = Boolean(excerpt || showContinueWithoutExcerpt);
---

<article class={articleClass}>
	<header class="mb-2">
		<h2 class="entry-title h3 mb-0">
			<a href={continueHref}>{title}</a>
		</h2>
		{meta && <div class="entry-meta">{meta}</div>}
	</header>

	<div class="entry-content text-muted lh-base">
		{image?.src && (
			<img
				src={image.src}
				class={imageClass}
				alt={image.alt || title}
				width="150"
				height="150"
			/>
		)}
		{shouldShowSummary && (
			<p>
				{excerpt}
				{excerpt && " "}
				<a href={continueHref}>
					Continue reading <span class="meta-nav">&rarr;</span>
				</a>
			</p>
		)}
	</div>
</article>
