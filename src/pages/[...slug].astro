---
import NotFound from "../components/NotFound.astro";
import PagePage from "../components/content/PagePage.astro";
import { getPageByPath, getPageBySlug, getProjectBySlug } from "../lib/content";
import { pageRedirect, projectPath } from "../lib/content-paths";
import { joinPath } from "../lib/path-utils";

const slugParts = Astro.params.slug?.split("/").filter(Boolean) ?? [];
const path = joinPath(slugParts);

const page =
	slugParts.length === 1
		? await getPageBySlug(path)
		: await getPageByPath(path);

if (!page) {
	const project = slugParts.length === 1 ? await getProjectBySlug(path) : null;
	if (project) {
		const status = Astro.url.searchParams.has("_preview") ? 302 : 301;
		return Astro.redirect(
			`/${projectPath(project.data.slug || project.id)}/${Astro.url.search}`,
			status,
		);
	}
}

if (page && page.data.path !== path) {
	return Astro.redirect(...pageRedirect(page.data.path, Astro.url));
}

if (!page) Astro.response.status = 404;
---

{page ? <PagePage page={page} /> : <NotFound />}
