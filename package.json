{
	"name": "engaged-philosophy",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"description": "Engaged Philosophy migrated to Astro + EmDash on Cloudflare Workers",
	"packageManager": "pnpm@12.18.0",
	"engines": {
		"node": "24.22.3",
		"pnpm": "12.18.0"
	},
	"scripts": {
		"dev": "astro dev",
		"build": "pnpm run test:seed && node scripts/clean-build-output.mjs && astro build",
		"ci": "pnpm run lint && pnpm run test && pnpm run check:emdash-types && pnpm run typecheck && pnpm run typecheck:tests && pnpm run build && pnpm run test:worker-bundle && pnpm run test:worker-runtime && pnpm run test:e2e",
		"check:emdash-types": "node scripts/check-emdash-types.mjs",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"lint:css": "stylelint \"src/scss/**/*.scss\"",
		"lint:eslint": "eslint eslint.config.js playwright.config.ts playwright.static.config.ts vitest.config.ts \"e2e/**/*.ts\" \"e2e-static/**/*.ts\" \"tests/**/*.ts\" \"scripts/**/*.mjs\" \"src/**/*.{js,ts,astro}\"",
		"lint": "pnpm run format:check && pnpm run lint:eslint && pnpm run lint:css",
		"lint:fix": "prettier --write . && pnpm run lint:eslint -- --fix && pnpm exec stylelint \"src/scss/**/*.scss\" --fix",
		"test": "pnpm run test:unit && pnpm run test:static",
		"test:unit": "vitest run",
		"test:unit:watch": "vitest",
		"test:seed": "vitest run tests/unit/seed.test.ts",
		"test:static": "playwright test --config playwright.static.config.ts",
		"test:static:headed": "playwright test --config playwright.static.config.ts --headed",
		"test:static:ui": "playwright test --config playwright.static.config.ts --ui",
		"test:worker-bundle": "node scripts/test-worker-bundle.mjs",
		"test:worker-runtime": "node scripts/test-worker-runtime.mjs",
		"test:e2e": "playwright test",
		"test:e2e:admin": "playwright test e2e/specs/admin",
		"test:e2e:editing": "playwright test e2e/specs/editing",
		"test:e2e:public": "playwright test e2e/specs/public",
		"test:e2e:headed": "playwright test --headed",
		"test:e2e:ui": "playwright test --ui",
		"smoke:live": "node scripts/test-smoke-live.mjs",
		"smoke:live:sitemap": "LIVE_SMOKE_SITEMAP=1 LIVE_SMOKE_REQUIRE_SITEMAP=1 node scripts/test-smoke-live.mjs",
		"preview": "astro preview",
		"deploy": "pnpm run build && wrangler deploy",
		"typecheck": "astro check",
		"typecheck:tests": "tsc --noEmit -p tsconfig.test.json"
	},
	"dependencies": {
		"@astrojs/cloudflare": "^14.4.8",
		"@astrojs/react": "^7.1.9",
		"@astrojs/rss": "^4.0.19",
		"@date-fns/tz": "^1.5.0",
		"@emdash-cms/auth": "^1.5.0",
		"@emdash-cms/cloudflare": "^1.5.0",
		"@emdash-cms/plugin-audit-log": "^0.2.4",
		"@emdash-cms/plugin-embeds": "^0.1.59",
		"astro": "^7.4.12",
		"bootstrap": "^5.3.9",
		"date-fns": "^4.4.0",
		"emdash": "^1.5.0",
		"jose": "^6.2.17",
		"kysely": "^0.29.9",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"sass": "^1.108.2"
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.12",
		"@cloudflare/workers-types": "^5.20261113.1",
		"@playwright/test": "^1.65.1",
		"@types/node": "^26.6.6",
		"@typescript-eslint/eslint-plugin": "^8.72.2",
		"@typescript-eslint/parser": "^8.72.2",
		"eslint": "^10.15.0",
		"eslint-plugin-astro": "^3.2.1",
		"playwright": "^1.65.1",
		"prettier": "^3.10.1",
		"prettier-plugin-astro": "^1.1.2",
		"stylelint": "^18.0.0",
		"stylelint-config-standard-scss": "^18.0.0",
		"typescript": "^6.0.3",
		"vite": "^8.3.8",
		"vitest": "^5.1.0",
		"wrangler": "^4.162.0"
	}
}
